{
  "name": "yar",
  "version": "0.0.0",
  "private": true,
  "description": "Yar — turn-based card roguelike for Android. Pure-TypeScript domain layer.",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "prettier": "^3.3.0",
    "test-renderer": "^1.2.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.1",
    "@react-navigation/native-stack": "^7.17.3",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "^56.0.11",
    "immer": "^11.1.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
  }
}
